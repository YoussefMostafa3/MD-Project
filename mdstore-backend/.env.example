# Fill these values from the Paymob dashboard. Keep real credentials in .env.
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_PUBLIC_KEY=
# Must be publicly reachable over HTTPS; Paymob cannot call localhost.
PAYMOB_NOTIFICATION_URL=
# Optional customer return URL (never used to confirm payment).
PAYMOB_REDIRECTION_URL=
